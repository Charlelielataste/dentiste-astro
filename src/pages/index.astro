---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Specialties from '../components/Specialties.astro';
import Technologies from '../components/Technologies.astro';
import Treatments from '../components/Treatments.astro';
import Values from '../components/Values.astro';
import Conseils from '../components/Conseils.astro';
import Urgences from '../components/Urgences.astro';
import Contact from '../components/Contact.astro';
import { getSettings } from '../lib/content';

const settings = await getSettings();

// Données structurées pour le SEO local
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Cabinet dentaire SuperDent',
  telephone: settings.phone,
  url: 'https://superdent.example/',
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.address.street,
    postalCode: settings.address.zip,
    addressLocality: settings.address.city,
    addressCountry: 'FR',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:30', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:30', closes: '13:00' },
  ],
};
---

<Base
  title="Dentiste Marseille | Cabinet dentaire SuperDent"
  description="Cabinet dentaire SuperDent à Marseille : implantologie, orthodontie, esthétique, parodontologie, pédodontie. Prenez rendez-vous en ligne."
  jsonLd={jsonLd}
>
  <Hero />
  <Stats />
  <About />
  <Team />
  <Specialties />
  <Technologies />
  <Treatments />
  <Values />
  <Conseils />
  <Urgences />
  <Contact />
</Base>
