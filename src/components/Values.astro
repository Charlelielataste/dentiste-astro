---
import SectionHead from './SectionHead.astro';
import { getValeurs } from '../lib/content';

const valeurs = await getValeurs();
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHead eyebrow="Nos valeurs" title="Ce qui guide notre pratique." align="center" />
    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {valeurs.map((v, i) => (
        <li data-reveal data-delay={0.07 * i} class="rounded-[2rem] bg-royal/5 p-7 ring-1 ring-royal/10">
          <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-sky to-royal text-lg font-semibold text-white">0{i + 1}</span>
          <h3 class="mt-6 text-2xl font-semibold tracking-tight">{v.title}</h3>
          <p class="mt-2 text-navy/65">{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
