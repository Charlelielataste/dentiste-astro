---
/**
 * Visuels « 3D verre » dessinés en SVG (placeholders de qualité en attendant de vrais rendus Blender / IA).
 * Pour passer aux vrais rendus : remplacer ce composant par un <img> WebP/AVIF à fond transparent.
 */
import type { GlassKind } from '../data/content';

interface Props {
  kind?: GlassKind;
  class?: string;
  shadow?: boolean;
}

const { kind = 'tooth', class: className = '', shadow = true } = Astro.props;
const id = `g${Math.random().toString(36).slice(2, 8)}`;

const toothPath =
  'M100 18 C 70 8, 38 20, 34 62 C 31 92, 48 112, 54 150 C 58 178, 58 218, 74 222 C 90 226, 90 180, 100 178 C 110 180, 110 226, 126 222 C 142 218, 142 178, 146 150 C 152 112, 169 92, 166 62 C 162 20, 130 8, 100 18 Z';
const incisorPath =
  'M60 44 C 60 16, 140 16, 140 44 L 148 104 C 150 154, 132 200, 117 204 C 106 207, 103 184, 100 184 C 97 184, 94 207, 83 204 C 68 200, 50 154, 52 104 Z';
const sparklePath =
  'M0 -11 C 1 -3.5 3.5 -1 11 0 C 3.5 1 1 3.5 0 11 C -1 3.5 -3.5 1 -11 0 C -3.5 -1 -1 -3.5 0 -11 Z';

const body = kind === 'tooth' || kind === 'gum' ? toothPath : incisorPath;
const isTooth = kind !== 'implant' && kind !== 'aligner';

const teeth = Array.from({ length: 9 }, (_, i) => {
  const t = (i - 4) / 4;
  return {
    x: 100 + t * 78,
    y: 78 + t * t * 58,
    r: t * 28,
    w: 25 - Math.abs(t) * 6,
    h: 42 - Math.abs(t) * 9,
  };
});
const threads = Array.from({ length: 7 }, (_, i) => 122 + i * 14);
---

<svg
  viewBox="0 0 200 240"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['overflow-visible', className]}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-body`} x1="0.15" y1="0" x2="0.85" y2="1">
      <stop offset="0" stop-color="#cfe9ff"></stop>
      <stop offset="0.32" stop-color="#54A2D9"></stop>
      <stop offset="0.74" stop-color="#2759A5"></stop>
      <stop offset="1" stop-color="#0A2358"></stop>
    </linearGradient>
    <linearGradient id={`${id}-glass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.85"></stop>
      <stop offset="1" stop-color="#54A2D9" stop-opacity="0.55"></stop>
    </linearGradient>
    <linearGradient id={`${id}-gum`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e3b09a" stop-opacity="0.92"></stop>
      <stop offset="1" stop-color="#A86F57" stop-opacity="0.9"></stop>
    </linearGradient>
    <radialGradient id={`${id}-hi`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id={`${id}-core`} cx="0.5" cy="0.42" r="0.55">
      <stop offset="0" stop-color="#a9dcff" stop-opacity="0.75"></stop>
      <stop offset="1" stop-color="#a9dcff" stop-opacity="0"></stop>
    </radialGradient>
    <filter id={`${id}-blur`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6"></feGaussianBlur>
    </filter>
    <filter id={`${id}-soft`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="1.6"></feGaussianBlur>
    </filter>
    <clipPath id={`${id}-clip`}><path d={body}></path></clipPath>
  </defs>

  {shadow && <ellipse cx="100" cy="233" rx="52" ry="6" fill="#0A2358" opacity="0.28" filter={`url(#${id}-blur)`}></ellipse>}

  {/* ── Dents (molaire, incisive, étincelles, enfant, gencive) ── */}
  {isTooth && (
    <g>
      <path d={body} fill={`url(#${id}-body)`}></path>
      <path d={body} fill={`url(#${id}-core)`}></path>
      <g clip-path={`url(#${id}-clip)`}>
        <ellipse cx="74" cy="46" rx="32" ry="18" fill={`url(#${id}-hi)`} transform="rotate(-24 74 46)"></ellipse>
        <path d="M54 74 C 52 104, 62 128, 68 152" stroke="#fff" stroke-opacity="0.55" stroke-width="5" stroke-linecap="round" filter={`url(#${id}-soft)`}></path>
        <ellipse cx="130" cy="172" rx="13" ry="30" fill="#cfe9ff" opacity="0.18"></ellipse>
      </g>
      <path d={body} stroke="#fff" stroke-opacity="0.7" stroke-width="1.6"></path>
    </g>
  )}

  {kind === 'gum' && (
    <g>
      <path d="M20 122 C 52 104, 72 130, 100 116 C 128 102, 150 130, 180 118 L 180 200 Q 180 230 150 230 L 50 230 Q 20 230 20 200 Z" fill={`url(#${id}-gum)`}></path>
      <path d="M26 124 C 54 108, 72 132, 100 120 C 128 108, 150 132, 176 122" stroke="#fff" stroke-opacity="0.55" stroke-width="3" stroke-linecap="round" filter={`url(#${id}-soft)`}></path>
    </g>
  )}

  {kind === 'sparkle' && (
    <g fill="#fff">
      <g transform="translate(152 52) scale(1.25)"><path d={sparklePath}></path></g>
      <g transform="translate(46 122) scale(0.8)" opacity="0.95"><path d={sparklePath}></path></g>
      <g transform="translate(160 150) scale(0.6)" opacity="0.9"><path d={sparklePath}></path></g>
    </g>
  )}

  {kind === 'kid' && (
    <g>
      <circle cx="86" cy="112" r="3.8" fill="#0A2358"></circle>
      <circle cx="114" cy="112" r="3.8" fill="#0A2358"></circle>
      <path d="M90 126 Q100 137 110 126" stroke="#0A2358" stroke-width="3" stroke-linecap="round"></path>
      <circle cx="77" cy="124" r="5" fill="#ffb4a0" opacity="0.5"></circle>
      <circle cx="123" cy="124" r="5" fill="#ffb4a0" opacity="0.5"></circle>
    </g>
  )}

  {/* ── Implant ── */}
  {kind === 'implant' && (
    <g>
      <path d="M78 112 H122 L116 214 Q100 227 84 214 Z" fill={`url(#${id}-body)`}></path>
      {threads.map((y) => (
        <path d={`M77 ${y} Q100 ${y + 9} 123 ${y - 5}`} stroke="#e6f4ff" stroke-opacity="0.8" stroke-width="3.2" stroke-linecap="round"></path>
      ))}
      <path d="M78 112 H122 L116 214 Q100 227 84 214 Z" stroke="#fff" stroke-opacity="0.6"></path>
      <rect x="86" y="94" width="28" height="22" rx="6" fill={`url(#${id}-body)`} stroke="#fff" stroke-opacity="0.6"></rect>
      <path d="M52 60 C 52 20, 148 20, 148 60 C 148 82, 140 96, 134 100 H66 C 60 96 52 82 52 60 Z" fill={`url(#${id}-body)`}></path>
      <path d="M52 60 C 52 20, 148 20, 148 60 C 148 82, 140 96, 134 100 H66 C 60 96 52 82 52 60 Z" fill={`url(#${id}-core)`}></path>
      <ellipse cx="80" cy="42" rx="28" ry="14" fill={`url(#${id}-hi)`} transform="rotate(-18 80 42)"></ellipse>
      <path d="M52 60 C 52 20, 148 20, 148 60 C 148 82, 140 96, 134 100 H66 C 60 96 52 82 52 60 Z" stroke="#fff" stroke-opacity="0.7" stroke-width="1.6"></path>
    </g>
  )}

  {/* ── Gouttière / aligneur ── */}
  {kind === 'aligner' && (
    <g transform="translate(0 38)">
      <path d="M14 146 Q 100 18 186 146" stroke={`url(#${id}-glass)`} stroke-width="48" stroke-opacity="0.35" stroke-linecap="round"></path>
      <path d="M14 146 Q 100 18 186 146" stroke="#fff" stroke-opacity="0.45" stroke-width="2" stroke-linecap="round" transform="translate(0 -22)"></path>
      {teeth.map((t) => (
        <rect
          x={t.x - t.w / 2}
          y={t.y - t.h / 2}
          width={t.w}
          height={t.h}
          rx={t.w / 2.6}
          transform={`rotate(${t.r} ${t.x} ${t.y})`}
          fill={`url(#${id}-glass)`}
          stroke="#fff"
          stroke-opacity="0.8"
        ></rect>
      ))}
    </g>
  )}
</svg>
