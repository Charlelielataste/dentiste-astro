---
import { getStats } from '../lib/content';

const stats = await getStats();
---

<section class="relative -mt-10">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div data-reveal class="glass grid grid-cols-2 gap-y-8 rounded-[2rem] p-6 sm:p-10 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class:list={['px-2 text-center lg:px-6', i > 0 && 'lg:border-l lg:border-navy/10']}>
          <p class="text-5xl font-semibold tracking-tight text-gradient sm:text-6xl">
            <span data-count={s.value}>{s.value}</span>
          </p>
          <p class="mt-2 text-sm text-navy/65">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
