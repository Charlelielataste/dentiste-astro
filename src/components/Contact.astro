---
import SectionHead from './SectionHead.astro';
import Button from './Button.astro';
import { getSettings } from '../lib/content';

const settings = await getSettings();
const field =
  'w-full rounded-2xl border border-navy/10 bg-white/80 px-4 py-3.5 text-base outline-none transition placeholder:text-navy/35 focus:border-royal focus:ring-4 focus:ring-sky/25';
---

<section id="contact" class="scroll-mt-24 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHead eyebrow="Accès & contact" title="Venez nous rencontrer." />

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <div data-reveal class="grid gap-6">
        <div class="glass rounded-[2rem] p-8">
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-royal">Adresse</h3>
          <address class="mt-3 text-xl font-semibold not-italic leading-snug tracking-tight">
            {settings.address.street}<br />{settings.address.zip} {settings.address.city}
          </address>
          <ul class="mt-4 space-y-1 text-sm text-navy/70">
            {settings.access.map((a) => <li>• {a}</li>)}
          </ul>
          <div class="mt-6"><Button href={settings.mapsUrl} variant="ghost" external>Itinéraire</Button></div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div class="glass rounded-[2rem] p-8">
            <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-royal">Horaires</h3>
            <ul class="mt-3 space-y-3">
              {settings.hours.map((h) => (
                <li><span class="block text-sm text-navy/60">{h.days}</span><span class="text-lg font-semibold tracking-tight">{h.time}</span></li>
              ))}
            </ul>
          </div>
          <div class="glass rounded-[2rem] p-8">
            <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-royal">Transports</h3>
            <ul class="mt-3 space-y-2 text-sm text-navy/75">
              {settings.transport.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <form data-reveal data-delay="0.1" data-demo-form class="glass rounded-[2rem] p-8 sm:p-10" action="#" method="post">
        <h3 class="text-2xl font-semibold tracking-tight">Contactez-nous</h3>
        <p class="mt-2 text-sm text-navy/65">
          Pour une urgence, appelez le <a class="font-semibold text-royal" href={settings.phoneHref}>{settings.phone}</a>.
          Merci de ne pas transmettre d'informations médicales par ce formulaire.
        </p>
        <div class="mt-6 grid gap-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid gap-1.5 text-sm font-medium">Nom<input class={field} type="text" name="nom" autocomplete="name" required placeholder="Votre nom" /></label>
            <label class="grid gap-1.5 text-sm font-medium">Téléphone<input class={field} type="tel" name="tel" autocomplete="tel" placeholder="06 00 00 00 00" /></label>
          </div>
          <label class="grid gap-1.5 text-sm font-medium">E-mail<input class={field} type="email" name="email" autocomplete="email" required placeholder="vous@exemple.fr" /></label>
          <label class="grid gap-1.5 text-sm font-medium">Message<textarea class={field} name="message" rows="4" required placeholder="Comment pouvons-nous vous aider ?"></textarea></label>
          <label class="flex items-start gap-3 text-xs leading-relaxed text-navy/65">
            <input type="checkbox" required class="mt-0.5 size-4 accent-royal" />
            J'accepte que ces informations soient utilisées pour répondre à ma demande. (Texte RGPD à rédiger avec le cabinet.)
          </label>
          <button
            type="submit"
            class="rounded-full bg-gradient-to-b from-royal to-navy px-6 py-3.5 font-semibold text-white shadow-[0_14px_30px_-10px_rgba(39,89,165,0.7)] transition hover:-translate-y-0.5"
          >
            Envoyer
          </button>
          <p data-demo-note hidden class="rounded-2xl bg-sky/15 px-4 py-3 text-sm text-royal">Formulaire de démonstration : l'envoi sera branché ultérieurement.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
  const note = form?.querySelector<HTMLElement>('[data-demo-note]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (note) note.hidden = false;
  });
</script>
