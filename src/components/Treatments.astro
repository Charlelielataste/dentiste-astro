---
import Glass from './Glass.astro';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';
import { getTraitements } from '../lib/content';

const all = await getTraitements();
const featured = all.find((t) => t.slug.startsWith('full-arch'));
const others = all.filter((t) => t !== featured);
---

<section id="traitements" class="scroll-mt-24 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHead
      eyebrow="Traitements"
      title="Les soins que nous réalisons."
      intro="Un aperçu de nos principaux traitements. Chaque situation est étudiée lors d'une consultation."
    />

    {featured && (
      <a
        href={`/traitements/${featured.slug}`}
        data-reveal
        class="group relative mt-14 grid items-center gap-6 overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-navy via-royal to-sky p-8 text-white sm:p-12 lg:grid-cols-[1.2fr_0.8fr]"
      >
        <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-24 size-96 rounded-full bg-white/15 blur-3xl"></div>
        <div class="relative">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-mist">À la une</p>
          <h3 class="mt-3 text-balance text-4xl font-semibold leading-[1.02] tracking-[-0.03em] sm:text-6xl">
            {featured.title.split(' — ').map((part) => <span class="block whitespace-nowrap">{part}</span>)}
          </h3>
          <p class="mt-5 max-w-lg text-lg text-white/75">{featured.short}</p>
          <span class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-navy">
            En savoir plus
            <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </div>
        <div class="relative mx-auto h-64 sm:h-80">
          <Glass kind="implant" class="h-full w-auto animate-float transition group-hover:scale-105" />
        </div>
      </a>
    )}

    <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {others.map((t, i) => (
        <li data-reveal data-delay={0.07 * i}>
          <a
            href={`/traitements/${t.slug}`}
            class="glass group flex h-full flex-col rounded-[2rem] p-6 transition duration-500 hover:-translate-y-1.5 hover:shadow-[0_40px_80px_-30px_rgba(39,89,165,0.55)]"
          >
            <div class="grid h-36 place-items-center rounded-[1.5rem] bg-gradient-to-br from-mist/40 to-sky/25">
              <Glass kind={t.kind} shadow={false} class="h-28 w-auto transition duration-700 group-hover:scale-110 group-hover:-rotate-3" />
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-tight">{t.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-navy/65">{t.short}</p>
            <span class="mt-4 text-sm font-semibold text-royal">Découvrir →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
