---
import Base from '../layouts/Base.astro';
import Glass from './Glass.astro';
import Button from './Button.astro';
import { getEntries, getSettings } from '../lib/content';
import type { EntryType } from '../lib/content';
import type { Entry } from '../data/content';

interface Props {
  entry: Entry;
  type: EntryType;
  label: string; // « Spécialité », « Traitement », « Technologie »
}

const { entry, type, label } = Astro.props;
const [settings, all] = await Promise.all([getSettings(), getEntries(type)]);
const others = all.filter((e) => e.slug !== entry.slug).slice(0, 3);
---

<Base title={`${entry.title} | Dentiste Marseille — SuperDent`} description={entry.short}>
  <section class="relative isolate overflow-hidden pb-16 pt-36 sm:pt-44">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -right-24 -top-20 size-[34rem] rounded-full bg-sky/25 blur-3xl"></div>
    </div>
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <nav aria-label="Fil d'Ariane" class="text-sm text-navy/60">
          <a href="/" class="hover:text-navy">Accueil</a> <span class="mx-1">/</span> <span>{label}</span>
        </nav>
        <h1 class="mt-6 text-5xl font-semibold leading-[1] tracking-[-0.035em] sm:text-7xl">
          <span class="text-gradient">{entry.title}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy/70">{entry.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={settings.rdvUrl}>Prendre RDV en ligne</Button>
          <Button href={settings.phoneHref} variant="ghost" arrow={false}>{settings.phone}</Button>
        </div>
      </div>
      <div class="relative mx-auto aspect-square w-full max-w-md">
        <div class="absolute inset-[8%] rounded-full bg-gradient-to-br from-sky/45 via-royal/20 to-transparent blur-2xl"></div>
        <div class="glass absolute inset-[10%] rotate-6 rounded-[3rem] opacity-70"></div>
        <Glass kind={entry.kind} class="absolute inset-[12%] size-[76%] animate-float drop-shadow-[0_40px_50px_rgba(10,35,88,0.35)]" />
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 class="sr-only">Points clés</h2>
      <ul class="grid gap-5 md:grid-cols-3">
        {entry.points.map((p, i) => (
          <li data-reveal data-delay={0.07 * i} class="glass rounded-[2rem] p-7">
            <span class="grid size-11 place-items-center rounded-2xl bg-gradient-to-br from-sky to-royal font-semibold text-white">0{i + 1}</span>
            <p class="mt-5 text-xl font-semibold leading-snug tracking-tight">{p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {entry.faq && entry.faq.length > 0 && (
    <section class="py-16">
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">Questions fréquentes</h2>
        <div class="mt-8 grid gap-3">
          {entry.faq.map((f) => (
            <details data-reveal class="glass group rounded-3xl p-6 open:bg-white/80">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold tracking-tight">
                {f.q}
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-royal/10 text-royal transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-navy/70">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div data-reveal class="rounded-[2.5rem] bg-gradient-to-br from-navy via-royal to-sky p-10 text-white sm:p-14">
        <h2 class="max-w-xl text-4xl font-semibold leading-[1.05] tracking-[-0.03em] sm:text-5xl">Parlons de votre projet.</h2>
        <p class="mt-4 max-w-lg text-white/75">Une consultation permet de faire le point sur votre situation et de définir ce qui vous convient.</p>
        <div class="mt-8"><Button href={settings.rdvUrl} variant="light">Prendre RDV en ligne</Button></div>
      </div>
    </div>
  </section>

  <section class="pb-24 pt-8">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-royal">À découvrir aussi</h2>
      <ul class="mt-6 grid gap-5 md:grid-cols-3">
        {others.map((o) => (
          <li>
            <a href={`/${type}/${o.slug}`} class="glass group flex h-full items-center gap-5 rounded-[2rem] p-5 transition duration-500 hover:-translate-y-1">
              <Glass kind={o.kind} shadow={false} class="h-20 w-auto shrink-0 transition duration-500 group-hover:scale-110" />
              <span>
                <span class="block text-lg font-semibold tracking-tight">{o.title}</span>
                <span class="mt-1 block text-sm text-navy/60">{o.short}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
